# Copy this file to .env and fill in real values. Never commit .env itself.

# --- App ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Data provider ---
# yfinance requires no API key and is the default. Set to "synthetic" to
# force demo mode (useful for offline development or CI).
PRIMARY_PROVIDER=yfinance

# If the primary provider is unreachable/rate-limited, serve clearly-labeled
# synthetic demo data instead of erroring. Every affected response carries
# is_synthetic=true so the frontend can show a banner. Set to false to
# have the API return a 503 instead of ever serving demo data.
ENABLE_SYNTHETIC_FALLBACK=true

# --- Optional paid providers (not required for yfinance) ---
# ALPHA_VANTAGE_API_KEY=
# FINANCIAL_MODELING_PREP_API_KEY=
# POLYGON_API_KEY=

# --- Database ---
# SQLite by default — zero setup, a single file. Point this at Postgres in
# production (every model is plain SQLAlchemy, so no code changes needed):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./stock_platform.db

# --- Auth ---
# MUST be a real secret in any deployment reachable by anyone but you.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=insecure-dev-secret-change-me
JWT_EXPIRE_MINUTES=10080

# --- Caching ---
# Leave unset to use the built-in in-memory cache (fine for local dev).
# Set for a shared cache across multiple backend workers/instances.
# REDIS_URL=redis://localhost:6379/0

# --- Risk model ---
DEFAULT_RISK_FREE_RATE=0.04

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
